[Unit]
Description=Create a consistent JELANI SQLite backup
After=jjelani.service

[Service]
Type=oneshot
User=jjelani
Group=jjelani
ExecStart=/usr/local/sbin/jjelani-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jjelani /var/backups/jjelani

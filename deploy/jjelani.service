[Unit]
Description=JELANI ordering and authentication API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jjelani
Group=jjelani
WorkingDirectory=/opt/jjelani/current
EnvironmentFile=/etc/jjelani/jjelani.env
ExecStart=/usr/bin/node /opt/jjelani/current/server-russia.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jjelani
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
